######################
# for gps
######################
on early-boot
    mkdir /data/vendor/gps 0751 root root
    # exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/init.cells.gps.sh

service vendor.gnss_service.cells /vendor/bin/hw/android.hardware.gnss-service
    class hal
    user nobody
    group nobody
